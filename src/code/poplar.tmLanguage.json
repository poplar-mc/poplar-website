{
  "name": "poplar",
  "scopeName": "source.poplar",
  "fileTypes": [
    "poplar"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#data-file"
    },
    {
      "include": "#command"
    },
    {
      "include": "#execute"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.poplar",
      "match": "//.*$"
    },
    "command": {
      "begin": "(?:^|(?<=[{};]))\\s*(/)(?![/*])([a-z_]+)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.command.poplar"
        },
        "2": {
          "name": "entity.name.function.command.poplar"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.poplar"
        }
      },
      "contentName": "string.unquoted.command.poplar",
      "patterns": [
        {
          "include": "#command-content"
        }
      ]
    },
    "execute": {
      "begin": "\\b(execute)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.execute.poplar"
        },
        "2": {
          "name": "punctuation.section.parens.begin.poplar"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.poplar"
        }
      },
      "contentName": "string.unquoted.command.poplar",
      "patterns": [
        {
          "include": "#command-content"
        }
      ]
    },
    "command-content": {
      "patterns": [
        {
          "include": "#insert"
        },
        {
          "include": "#macro-key"
        },
        {
          "include": "#string"
        },
        {
          "include": "#selector"
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#command-content"
            }
          ]
        },
        {
          "begin": "\\{(?!\\{)",
          "end": "\\}",
          "patterns": [
            {
              "include": "#command-content"
            }
          ]
        }
      ]
    },
    "insert": {
      "name": "meta.embedded.insert.poplar",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.poplar"
        }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.poplar"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "data-file": {
      "comment": "`predicate isSneaking { ...json... }` (or a JSON list) at the top level",
      "begin": "^([a-z][A-Za-z0-9]*)\\s+([A-Za-z_][A-Za-z0-9_]*|\"[^\"]*\")\\s*([\\{\\[])",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.data-file.poplar"
        },
        "2": {
          "name": "entity.name.constant.poplar"
        },
        "3": {
          "name": "punctuation.section.braces.begin.poplar"
        }
      },
      "end": "[\\}\\]]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.poplar"
        }
      },
      "patterns": [
        {
          "include": "#json"
        }
      ]
    },
    "json": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#json"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#json"
            }
          ]
        },
        {
          "name": "support.type.property-name.json.poplar",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"(?=\\s*:)"
        },
        {
          "name": "string.quoted.double.json.poplar",
          "match": "\"(?:[^\"\\\\]|\\\\.)*\""
        },
        {
          "name": "constant.numeric.json.poplar",
          "match": "-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?"
        },
        {
          "name": "constant.language.json.poplar",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "declaration": {
      "begin": "\\b(mcfun)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.poplar"
        },
        "2": {
          "name": "entity.name.function.poplar"
        },
        "3": {
          "name": "punctuation.section.parens.begin.poplar"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.poplar"
        }
      },
      "patterns": []
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#minecraft-check"
        },
        {
          "name": "storage.type.poplar",
          "match": "\\b(mcfun|var)\\b"
        },
        {
          "name": "keyword.control.import.poplar",
          "match": "\\b(import|namespace)\\b"
        },
        {
          "name": "keyword.control.poplar",
          "match": "\\b(if|else|for|while|return|break|continue|execute)\\b"
        },
        {
          "comment": "`with entity @s` and `with block ~ ~ ~` pass raw Minecraft text",
          "match": "\\b(with)\\s+(entity|block)\\b([^;]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.word.poplar"
            },
            "2": {
              "name": "keyword.other.poplar"
            },
            "3": {
              "name": "string.unquoted.command.poplar"
            }
          }
        },
        {
          "name": "keyword.operator.word.poplar",
          "match": "\\b(and|or|with)\\b"
        },
        {
          "name": "constant.language.poplar",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "comment": "`magic` in `magic:heal()`, and the name in `namespace combat;` / `import magic;`",
          "name": "entity.name.namespace.poplar",
          "match": "\\b[a-z0-9_.]+(?=:[A-Za-z_])|(?<=\\bnamespace |\\bimport )[a-z0-9_.]+"
        },
        {
          "name": "support.function.builtin.poplar",
          "match": "\\b(append|prepend|insert|remove|len|text|onEvent|onTrigger|onDeath|onFirstJoin|onJoin|onRespawn|slice|str|startsWith|endsWith)(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.poplar",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "match": "\\|\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\|",
          "captures": {
            "1": {
              "name": "variable.parameter.poplar"
            }
          }
        },
        {
          "include": "#selector"
        },
        {
          "name": "variable.language.score.poplar",
          "match": "#(?:[a-z0-9_.]+:)?[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "include": "#macro-key"
        },
        {
          "name": "variable.other.property.data.poplar",
          "match": "\\$(?:[a-z0-9_.]+:)?(?:\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_]*)(?:\\.(?:\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_]*)|\\[[^\\]]*\\])*"
        },
        {
          "name": "variable.other.property.key.poplar",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        },
        {
          "name": "constant.numeric.poplar",
          "match": "\\b\\d+(?:\\.\\d+)?[bBsSlLfFdD]?\\b"
        },
        {
          "name": "keyword.operator.poplar",
          "match": "==|!=|<=|>=|\\.\\.|[<>=+\\-*/%!]"
        },
        {
          "name": "punctuation.terminator.poplar",
          "match": ";"
        },
        {
          "name": "punctuation.separator.poplar",
          "match": "[,.]"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.poplar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.poplar",
          "match": "\\\\[\"\\\\]"
        }
      ]
    },
    "selector": {
      "name": "entity.name.tag.selector.poplar",
      "match": "@[aeprsn](?:\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])?"
    },
    "minecraft-check": {
      "comment": "`if (block ~ ~-1 ~ stone and ...)`: an `execute if` subcommand as raw text",
      "begin": "(?<=[(!]|\\band |\\bor )\\s*\\b(biome|block|blocks|data|dimension|entity|function|items|loaded|predicate|score|slots|stopwatch)\\s+(?=[^\\s=<>!)+*/%.,;])",
      "beginCaptures": {
        "1": {
          "name": "support.function.check.poplar"
        }
      },
      "end": "(?=\\s+(?:and|or)\\b|\\))",
      "contentName": "string.unquoted.check.poplar",
      "patterns": [
        {
          "include": "#insert"
        },
        {
          "include": "#macro-key"
        },
        {
          "include": "#selector"
        }
      ]
    },
    "macro-key": {
      "comment": "`$(name)`: a macro argument of the mcfun",
      "name": "variable.parameter.poplar",
      "match": "\\$\\([A-Za-z_][A-Za-z0-9_]*\\)"
    }
  }
}
