---
import ThemeToggle from './ThemeToggle.astro';

const { links } = Astro.props;
---

<button
  type="button"
  popovertarget="home-menu"
  aria-label="Menu"
  class="home-menu-button grid size-11 shrink-0 cursor-pointer place-items-center rounded-md border-2 border-line-strong bg-paper p-0 text-ink shadow-block-quiet transition duration-120 ease-out hover:bg-plank-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus active:translate-y-0.5 active:shadow-none motion-reduce:transition-none motion-reduce:active:translate-y-0 md:hidden"
>
  <svg class="open-menu" aria-hidden="true" width="20" height="20" viewBox="0 0 10 10" shape-rendering="crispEdges" fill="currentColor"><rect x="1" y="1" width="8" height="2"></rect><rect x="1" y="4" width="8" height="2"></rect><rect x="1" y="7" width="8" height="2"></rect></svg>
  <svg class="close-menu" aria-hidden="true" width="20" height="20" viewBox="0 0 10 10" shape-rendering="crispEdges" fill="currentColor"><rect x="1" y="1" width="2" height="2"></rect><rect x="7" y="1" width="2" height="2"></rect><rect x="3" y="3" width="1" height="1"></rect><rect x="6" y="3" width="1" height="1"></rect><rect x="4" y="4" width="2" height="2"></rect><rect x="3" y="6" width="1" height="1"></rect><rect x="6" y="6" width="1" height="1"></rect><rect x="1" y="7" width="2" height="2"></rect><rect x="7" y="7" width="2" height="2"></rect></svg>
</button>

<div id="home-menu" popover class="fixed box-border inset-x-0 top-[73px] bottom-0 m-0 h-auto w-full max-w-none border-0 border-t border-line bg-plank-100 p-4 text-ink md:hidden">
  <div class="flex flex-col text-lg font-bold">
    {
      links.map((link) => (
        <a href={link.href} target={link.external ? '_blank' : undefined} class="border-b border-line py-3 text-ink no-underline hover:text-leaf">
          {link.label}
        </a>
      ))
    }
    <div class="flex items-center justify-between py-3">
      <span>Theme</span>
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  .home-menu-button:has(~ :popover-open) .open-menu,
  .home-menu-button:not(:has(~ :popover-open)) .close-menu {
    display: none;
  }
</style>

<style is:global>
  @media (max-width: 49.99rem) {
    body:has(#home-menu:popover-open) {
      overflow: hidden;
    }
  }
</style>

<script>
  const menu = document.getElementById('home-menu');
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.hidePopover()));
</script>
