// The smallest pack: a greeting when the pack loads.
namespace hello

// A constant only exists while the pack is built. `{{...}}` writes it into a command.
const name = "Poplar"

var #loads = 0

mcfun load:
    #loads = #loads + 1

    /say Hello from {{name}}!

    // A score is read in the game, so this line becomes a macro line.
    /say This pack has loaded {{#loads}} times

    // `for` repeats its body while the pack is built: three `say` commands.
    for step in 1..4:
        /say Step {{step}}
